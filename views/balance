{{define "content"}}
<div class="container">
  <div class="topbar">
    <div class="fecha-display" id="periodoDisplay" title="Seleccionar período">
      <i id="periodoTexto">Este mes</i>
      <select id="periodoSelect" style="display:none;">
        <option value="semana">Esta semana</option>
        <option value="mes" selected>Este mes</option>
        <option value="anio">Este año</option>
        <option value="personalizado">Personalizado</option>
      </select>
    </div>

    <div class="tabs" role="tablist" aria-label="Pestañas">
      <a href="/balance?tipo=balance&periodo={{.PeriodoActual}}" 
         class="tab {{if eq .Tipo "balance"}}active{{end}}">Balance</a>
      <a href="/balance?tipo=graficos&periodo={{.PeriodoActual}}" 
         class="tab {{if eq .Tipo "graficos"}}active{{end}}">Gráficos</a>
    </div>

    {{if .SessionData.IsAdmin}}
    <div class="usuarios-filter">
      {{range .UsuariosFamilia}}
      <button class="user-filter-btn {{if eq .NombreUsuario $.UsuarioFiltro}}active{{end}}" 
              data-usuario="{{.NombreUsuario}}" 
              style="background-color: {{.Color}};"
              title="{{.NombrePersonal}}">
        {{substr .NombrePersonal 0 1}}
      </button>
      {{end}}
      <button class="user-filter-btn {{if not .UsuarioFiltro}}active{{end}}" 
              data-usuario="todos"
              title="Ver todos">
        👥
      </button>
    </div>
    {{end}}
  </div>

  <!-- MAIN -->
  <div class="main_balance">
    {{if eq .Tipo "balance"}}
    <!-- VISTA BALANCE PRINCIPAL -->
    <div class="resumen-container">
      <div class="resumen-column">
        <h3 class="resumen-title">Ingresos</h3>
        <div class="movements-list">
          {{if .MovimientosIngresos}}
            {{range .MovimientosIngresos}}
            <div class="movement-card" data-id="{{.IdMovimiento}}" 
                 style="border-left-color: {{.ColorUsuario}};">
              <div class="movement-icon" style="background-color: {{.ColorConcepto}};">
                <i class="{{.IconoConcepto}}"></i>
              </div>
              
              <div class="movement-body">
                <div class="movement-title">{{.NombreConcepto}}</div>
                <div class="movement-meta">
                  <span class="movement-date">{{.Fecha}}</span>
                  {{if $.SessionData.IsAdmin}}
                  <span class="movement-user" style="color: {{.ColorUsuario}};">
                    {{.NombreUsuario}}
                  </span>
                  {{end}}
                </div>
              </div>
              
              <div class="movement-amount">S/ {{printf "%.2f" .Monto}}</div>
            </div>
            {{end}}
          {{else}}
          <div class="movement-card" style="justify-content:center;color:var(--muted)">
            Sin Ingresos
          </div>
          {{end}}
        </div>
        <div class="resumen-total ingreso">
          Total Ingresos: S/ {{printf "%.2f" .TotalIngresos}}
        </div>
      </div>

      <div class="resumen-column">
        <h3 class="resumen-title">Gastos</h3>
        <div class="movements-list">
          {{if .MovimientosGastos}}
            {{range .MovimientosGastos}}
            <div class="movement-card" data-id="{{.IdMovimiento}}"
                 style="border-left-color: {{.ColorUsuario}};">
              <div class="movement-icon" style="background-color: {{.ColorConcepto}};">
                <i class="{{.IconoConcepto}}"></i>
              </div>
              
              <div class="movement-body">
                <div class="movement-title">{{.NombreConcepto}}</div>
                <div class="movement-meta">
                  <span class="movement-date">{{.Fecha}}</span>
                  {{if $.SessionData.IsAdmin}}
                  <span class="movement-user" style="color: {{.ColorUsuario}};">
                    {{.NombreUsuario}}
                  </span>
                  {{end}}
                </div>
              </div>
              
              <div class="movement-amount">S/ {{printf "%.2f" .Monto}}</div>
            </div>
            {{end}}
          {{else}}
          <div class="movement-card" style="justify-content:center;color:var(--muted)">
            Sin Gastos
          </div>
          {{end}}
        </div>
        <div class="resumen-total gasto">
          Total Gastos: S/ {{printf "%.2f" .TotalGastos}}
        </div>
      </div>

      <div class="balance-column">
        <h3 class="resumen-title">Balance</h3>
        <div class="balance-cards">
          <div class="balance-card">
            <div class="balance-periodo">Este mes</div>
            <div class="balance-monto {{if ge .BalanceMensual 0.0}}positivo{{else}}negativo{{end}}">
              S/ {{printf "%.2f" .BalanceMensual}}
            </div>
          </div>
          
          <div class="balance-card">
            <div class="balance-periodo">Anual</div>
            <div class="balance-monto {{if ge .BalanceAnual 0.0}}positivo{{else}}negativo{{end}}">
              S/ {{printf "%.2f" .BalanceAnual}}
            </div>
          </div>

          {{if .SessionData.IsAdmin}}
          <div class="balance-card global">
            <div class="balance-periodo">Balance Global</div>
            <div class="balance-monto {{if ge .BalanceGlobal 0.0}}positivo{{else}}negativo{{end}}">
              S/ {{printf "%.2f" .BalanceGlobal}}
            </div>
          </div>
          {{end}}
        </div>

        {{if .SessionData.IsAdmin}}
        <div class="usuarios-balance">
          <h4>Balance por Usuario</h4>
          {{range .UsuariosBalance}}
          <div class="usuario-balance-row">
            <div class="usuario-info">
              <span class="usuario-color" style="background-color: {{.Color}};"></span>
              <span class="usuario-nombre">{{.NombrePersonal}}</span>
            </div>
            <div class="usuario-monto {{if ge .Balance 0.0}}positivo{{else}}negativo{{end}}">
              S/ {{printf "%.2f" .Balance}}
            </div>
          </div>
          {{end}}
        </div>
        {{end}}
      </div>
    </div>

    {{else}}
    <!-- VISTA GRÁFICOS -->
    <div class="graficos-container">
      <div class="graficos-controls">
        <div class="grafico-tipo">
          <button class="tipo-btn {{if eq .TipoGrafico "circular"}}active{{end}}" 
                  data-tipo="circular">Circular</button>
          <button class="tipo-btn {{if eq .TipoGrafico "barras"}}active{{end}}" 
                  data-tipo="barras">Barras</button>
          {{if .SessionData.IsAdmin}}
          <button class="tipo-btn {{if eq .TipoGrafico "miembros"}}active{{end}}" 
                  data-tipo="miembros">Miembros</button>
          <button class="tipo-btn {{if eq .TipoGrafico "conceptos"}}active{{end}}" 
                  data-tipo="conceptos">Conceptos</button>
          {{end}}
        </div>
      </div>

      <div class="graficos-grid">
        <div class="grafico-card">
          <h3>Ingresos</h3>
          <div class="grafico-placeholder" id="graficoIngresos">
            <div class="grafico-simulado">
              {{if eq .TipoGrafico "circular"}}
              <div class="circular-chart">
                {{range .IngresosData}}
                <div class="chart-slice" style="--porcentaje: {{.Porcentaje}}%; background-color: {{.Color}};">
                  <span class="slice-label">{{.Porcentaje}}%</span>
                </div>
                {{end}}
              </div>
              {{else if eq .TipoGrafico "barras"}}
              <div class="bar-chart">
                {{range .IngresosData}}
                <div class="bar-container">
                  <div class="bar" style="height: {{.Porcentaje}}%; background-color: {{.Color}};"></div>
                  <span class="bar-label">{{.Etiqueta}}</span>
                </div>
                {{end}}
              </div>
              {{end}}
            </div>
          </div>
          <div class="grafico-leyenda">
            {{range .IngresosData}}
            <div class="leyenda-item">
              <span class="leyenda-color" style="background-color: {{.Color}};"></span>
              <span class="leyenda-texto">{{.Etiqueta}}: S/ {{printf "%.2f" .Monto}} ({{.Porcentaje}}%)</span>
            </div>
            {{end}}
          </div>
        </div>

        <div class="grafico-card">
          <h3>Gastos</h3>
          <div class="grafico-placeholder" id="graficoGastos">
            <div class="grafico-simulado">
              {{if eq .TipoGrafico "circular"}}
              <div class="circular-chart">
                {{range .GastosData}}
                <div class="chart-slice" style="--porcentaje: {{.Porcentaje}}%; background-color: {{.Color}};">
                  <span class="slice-label">{{.Porcentaje}}%</span>
                </div>
                {{end}}
              </div>
              {{else if eq .TipoGrafico "barras"}}
              <div class="bar-chart">
                {{range .GastosData}}
                <div class="bar-container">
                  <div class="bar" style="height: {{.Porcentaje}}%; background-color: {{.Color}};"></div>
                  <span class="bar-label">{{.Etiqueta}}</span>
                </div>
                {{end}}
              </div>
              {{end}}
            </div>
          </div>
          <div class="grafico-leyenda">
            {{range .GastosData}}
            <div class="leyenda-item">
              <span class="leyenda-color" style="background-color: {{.Color}};"></span>
              <span class="leyenda-texto">{{.Etiqueta}}: S/ {{printf "%.2f" .Monto}} ({{.Porcentaje}}%)</span>
            </div>
            {{end}}
          </div>
        </div>
      </div>

      {{if and .SessionData.IsAdmin (eq .TipoGrafico "miembros")}}
      <div class="graficos-comparativa">
        <h3>Comparativa por Miembros</h3>
        <div class="comparativa-grid">
          {{range .ComparativaMiembros}}
          <div class="comparativa-card">
            <div class="comparativa-header" style="border-left-color: {{.Color}};">
              <span class="comparativa-usuario">{{.Nombre}}</span>
            </div>
            <div class="comparativa-data">
              <div class="comparativa-item">
                <span>Ingresos:</span>
                <span class="positivo">S/ {{printf "%.2f" .Ingresos}}</span>
              </div>
              <div class="comparativa-item">
                <span>Gastos:</span>
                <span class="negativo">S/ {{printf "%.2f" .Gastos}}</span>
              </div>
              <div class="comparativa-item">
                <span>Balance:</span>
                <span class="{{if ge .Balance 0.0}}positivo{{else}}negativo{{end}}">
                  S/ {{printf "%.2f" .Balance}}
                </span>
              </div>
            </div>
          </div>
          {{end}}
        </div>
      </div>
      {{end}}
    </div>
    {{end}}
  </div>
</div>

<script>
  // Funcionalidad para cambiar período
  document.getElementById('periodoDisplay').addEventListener('click', function() {
    const select = document.getElementById('periodoSelect');
    const texto = document.getElementById('periodoTexto');
    
    if (select.style.display === 'none') {
      select.style.display = 'block';
      texto.style.display = 'none';
    } else {
      select.style.display = 'none';
      texto.style.display = 'block';
      texto.textContent = select.options[select.selectedIndex].text;
      
      // Recargar con nuevo período
      const url = new URL(window.location.href);
      url.searchParams.set('periodo', select.value);
      window.location.href = url.toString();
    }
  });

  // Filtro por usuario (solo admin)
  document.querySelectorAll('.user-filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const usuario = this.dataset.usuario;
      const url = new URL(window.location.href);
      
      if (usuario === 'todos') {
        url.searchParams.delete('usuario');
      } else {
        url.searchParams.set('usuario', usuario);
      }
      
      window.location.href = url.toString();
    });
  });

  // Cambiar tipo de gráfico
  document.querySelectorAll('.tipo-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const tipo = this.dataset.tipo;
      const url = new URL(window.location.href);
      url.searchParams.set('tipoGrafico', tipo);
      window.location.href = url.toString();
    });
  });

  // Click en movimiento para editar
  document.querySelectorAll('.movement-card[data-id]').forEach(card => {
    card.addEventListener('click', function() {
      const movimientoId = this.dataset.id;
      window.location.href = `/movimientos/editar/${movimientoId}`;
    });
  });

  // Helper para substring
  function substr(str, start, length) {
    return str.substring(start, start + length);
  }
</script>
{{end}}

{{define "page-css"}}
<link rel="stylesheet" href="/static/css/pages/balance.css">
{{end}}

{{define "page-js"}}
<script src="/static/js/pages/balance.js"></script>
{{end}}
